# 得逸智行平台 —— 生产环境变量模板
#
# 用法：cp .env.example .env，然后把每个 CHANGEME_ 开头的值换成强随机值。
# 本文件只放占位，绝不写真实密钥；.env 加入 .gitignore，永不入库。

# --- 必设：数据库 ---
POSTGRES_PASSWORD=CHANGEME_postgres_32char_min

# --- 必设：Keycloak ---
KEYCLOAK_ADMIN_PASSWORD=CHANGEME_keycloak_admin_32char_min

# --- 必设：LiteLLM 内部 master key（仅 control-plane ↔ litellm）---
LITELLM_MASTER_KEY=CHANGEME_litellm_master_32char_min

# --- 必设：Keycloak OIDC（生产 JWT aud 校验，与 Keycloak client 的 audience 一致）---
# KEYCLOAK_URL 由 compose/k8s 内部服务名提供；这里只需受众
KEYCLOAK_AUDIENCE=CHANGEME_keycloak_audience

# --- 必设：平台运维 token（租户 CRUD）---
OPERATOR_TOKEN=CHANGEME_operator_token_32char_min

# --- 必设：至少一个模型供应商 key（对应 litellm/config.yaml 的 model_list）---
DEFAULT_API_KEY=CHANGEME_provider_api_key
# 可选：覆盖默认 OpenAI 地址（如用 Azure/自建网关/vLLM）
# DEFAULT_API_BASE=https://api.openai.com/v1

# --- 推荐：API Key 服务端 pepper（纵深防御；轮换见 keys.mjs 注释）---
# API_KEY_PEPPER=CHANGEME_pepper_32char_min
# API_KEY_PEPPER_PREVIOUS=  # 旧 pepper，逗号分隔；确认旧 key 全部轮换后再清空

# --- 必设（生产）：审计链外部锚定 ---
# AUDIT_ANCHOR_URL=https://anchor.example.com/api/v1/anchor  # 生产必填（config 校验）

# --- 可选 ---
DEYI_ENV=production
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# GITEA_URL=https://gitea.example.com  # 设了 gitea 仓库绑定才走真 Gitea API/Actions，否则 fake fallback
# 通知通道：webhook 投递超时（ms）；私网目标默认拒绝，内网 webhook 才打开
# NOTIFY_TIMEOUT_MS=8000
# NOTIFY_ALLOW_PRIVATE_TARGETS=false
# 注意：生产禁止设置 DEV_IDP_SECRET（config 启动校验会直接拒绝启动）
